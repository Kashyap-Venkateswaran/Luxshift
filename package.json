{
  "name": "luxshift",
  "version": "2.0.2",
  "description": "LuxShift desktop app - reduce eye strain and protect sleep schedule when working late",
  "main": "main.js",
  "author": "Kashyap-Venkateswaran",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuxshiftOfficial/Luxshift.git"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "pack": "electron-builder --dir --mac --universal",
    "dist": "electron-builder --mac --universal && node scripts/organize-build.js"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@notionhq/client": "^2.3.0",
    "cors": "^2.8.6",
    "dompurify": "^3.1.6",
    "dotenv": "^16.6.1",
    "electron-store": "^8.1.0",
    "express": "^4.19.2",
    "express-rate-limit": "^6.11.2",
    "googleapis": "^144.0.0",
    "helmet": "^7.1.0",
    "ical.js": "^1.5.0",
    "node-fetch": "^3.3.2",
    "sharp": "^0.33.4",
    "suncalc": "^1.9.0"
  },
  "build": {
    "appId": "com.luxshiftofficial.luxshift",
    "productName": "LuxShift",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/.cache/**",
      "!.git/**",
      "!.github/**",
      "!.gitignore",
      "!README.md",
      "!*.swift",
      "!nvidia_env.rtf",
      "!scripts/**"
    ],
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "minimumSystemVersion": "10.15.0",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/**/*.{node,dylib}",
      "extendInfo": {
        "NSLocationWhenInUseUsageDescription": "LuxShift uses your location to calculate accurate sunrise, sunset, and golden-hour times for sunlight exposure reminders, and to fetch local weather for those suggestions."
      }
    },
    "extraResources": [
      {
        "from": "assets/nightshift-control",
        "to": "assets/nightshift-control"
      },
      {
        "from": "assets/brightness-control",
        "to": "assets/brightness-control"
      }
    ],
    "asarUnpack": [
      "assets/nightshift-control",
      "assets/brightness-control"
    ]
  }
}
cat > .gitignore << 'EOF'
# Secrets — never commit
credentials.json
.env
.env.*
*.pem
*.key

# Dependencies
node_modules/

# Build output
dist/
releases/
build/*.tmp

# Local logs
*.log
server.log
npm-debug.log*

# OS junk
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Claude Code / AI assistant working folders — not app source
.claude/
.agent-work/
.chat-summaries-full/
imagesforclaudecode/
.imagesforclaudecode/

# Misc
nvidia_env.rtf
*.env.rtf
EOF